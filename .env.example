# Скопируйте этот файл в .env и заполните значения. Реальные ключи в Git не попадают.

# --- Обязательные ---
# Токен бота от @BotFather
BOT_TOKEN=
# Строка подключения к PostgreSQL (драйвер asyncpg)
DATABASE_URL=postgresql+asyncpg://memomaster:memomaster@localhost:5432/memomaster

# --- Необязательные: если пусто, функция отключается, остальной бот работает ---
# Giphy: https://developers.giphy.com/ (GIF-реакции в конце игры)
GIPHY_API_KEY=
# Reddit: https://www.reddit.com/prefs/apps (раздел «Мем дня»)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=memomaster-bot/0.1 (учебный проект)

# --- Прочее ---
LOG_LEVEL=INFO
