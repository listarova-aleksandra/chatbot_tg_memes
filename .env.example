# Скопируйте этот файл в .env и заполните значения. Реальные ключи в Git не попадают.

# --- Обязательные ---
# Токен бота от @BotFather
BOT_TOKEN=
# Строка подключения к PostgreSQL (драйвер asyncpg)
DATABASE_URL=postgresql+asyncpg://memomaster:memomaster@localhost:5432/memomaster

# --- Необязательные: если пусто, функция отключается, остальной бот работает ---
# Giphy: https://developers.giphy.com/ (GIF-реакции в конце игры и картинки для вопросов «Что это за мем?»)
GIPHY_API_KEY=
# Reddit: https://www.reddit.com/prefs/apps (раздел «Мем дня»)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=memomaster-bot/0.1 (учебный проект)

# Imgflip: ключи не нужны. Бот берёт шаблоны открытым методом get_memes, а текст на картинке
# рисует сам (Pillow), поэтому IMGFLIP_USERNAME / IMGFLIP_PASSWORD не используются.

# --- HTTP-запросы к внешним API (можно не менять) ---
HTTP_TIMEOUT_SECONDS=5
HTTP_MAX_RETRIES=3

# --- Прочее ---
LOG_LEVEL=INFO
